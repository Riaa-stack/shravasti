# App
APP_ENV=development
SECRET_KEY=super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=scholarforge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# ChromaDB
CHROMA_PERSIST_DIR=/data/chroma

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=secretpassword

# OpenRouter (LLM)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_LITERATURE_REVIEW=deepseek/deepseek-chat
LLM_MODEL_METHODOLOGY=deepseek/deepseek-chat
LLM_MODEL_GAP=deepseek/deepseek-r1
LLM_MODEL_TREND=qwen/qwen-2.5-72b-instruct
LLM_MODEL_IDEA=deepseek/deepseek-r1
LLM_MODEL_CITATION=mistralai/mistral-small
LLM_MODEL_CHAT=deepseek/deepseek-chat
LLM_MODEL_DIFFICULTY=google/gemma-3-27b-it

# Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_FALLBACK_MODEL=sentence-transformers/all-MiniLM-L6-v2

# OCR / NLP
EASYOCR_LANGS=en
GROBID_ENABLED=false
GROBID_URL=http://grobid:8070

# External Research APIs
CROSSREF_ENABLED=true
CROSSREF_MAILTO=
SEMANTIC_SCHOLAR_API_KEY=
ARXIV_ENABLED=true
OPENALEX_ENABLED=true
OPENALEX_MAILTO=

# Storage
PAPERS_STORAGE_DIR=/data/papers
EXPORTS_STORAGE_DIR=/data/exports
